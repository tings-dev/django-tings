msgid "Filter rows"
msgstr "Zeilen filtern"

msgid "No data available"
msgstr "Keine Daten verfügbar"

msgid "There is no data to display yet."
msgstr "Es sind noch keine Daten vorhanden."

msgid "No matching data"
msgstr "Keine passenden Daten"

msgid "Try changing or clearing the search and filters."
msgstr "Ändern oder leeren Sie die Suche und die Filter."

msgid "Data"
msgstr "Daten"

msgid "Search data"
msgstr "Daten durchsuchen"

msgid "All values"
msgstr "Alle Werte"

#, python-format
msgid "%(column_label)s from"
msgstr "%(column_label)s von"

#, python-format
msgid "%(column_label)s to"
msgstr "%(column_label)s bis"

#, python-format
msgid "%(counter)s record"
msgid_plural "%(counter)s records"
msgstr[0] "%(counter)s Datensatz"
msgstr[1] "%(counter)s Datensätze"

msgid "Table pages"
msgstr "Tabellenseiten"

msgid "First page"
msgstr "Erste Seite"

msgid "Previous page"
msgstr "Vorherige Seite"

#, python-format
msgid "Page %(page)s of %(pages)s"
msgstr "Seite %(page)s von %(pages)s"

msgid "Next page"
msgstr "Nächste Seite"

msgid "Last page"
msgstr "Letzte Seite"

