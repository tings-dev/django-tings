msgstr "Scrollen Sie die Tabelle horizontal, um alle Spalten zu sehen"

msgid "Select"
msgstr "Auswählen"

msgid "Sort results"
msgstr "Ergebnisse sortieren"

msgid "Sorted descending"
msgstr "Absteigend sortiert"

msgid "Sorted ascending"
msgstr "Aufsteigend sortiert"

msgid "Clear search and filters"
msgstr "Suche und Filter leeren"

msgid "Search"
msgstr "Suchen"

